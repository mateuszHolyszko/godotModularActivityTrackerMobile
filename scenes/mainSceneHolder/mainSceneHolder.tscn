[sub_resource type="GDScript" id="GDScript_1vr3a"]
script/source = "extends TextureRect

@export var sub_viewport: SubViewport


func _gui_input(event: InputEvent) -> void:
	if sub_viewport:
		sub_viewport.push_input(event)
"

