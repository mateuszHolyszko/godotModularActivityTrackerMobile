[sub_resource type="GDScript" id="GDScript_7ptm5"]
script/source = "extends VBoxContainer

var workout_session: WorkoutSession

# Store original modulation to restore later
var _original_modulate: Color = Color.WHITE
var _is_ui_enabled: bool = true

@export var blocker: ColorRect

func _ready():
	workout_session = GlobalElements.CurrentWorkout
	_original_modulate = modulate
	_connect_signals()
	# Start with UI enabled by default
	_set_ui_enabled(true)


func _connect_signals():
	if not workout_session:
		push_error(\"WorkoutSessionManager: WorkoutSession node not found\")
		return
	
	# Connect to workout signals
	if not workout_session.workout_started.is_connected(_on_workout_started):
		workout_session.workout_started.connect(_on_workout_started)
	
	if not workout_session.workout_completed.is_connected(_on_workout_completed):
		workout_session.workout_completed.connect(_on_workout_completed)
	
	if not workout_session.workout_cancelled.is_connected(_on_workout_cancelled):
		workout_session.workout_cancelled.connect(_on_workout_cancelled)

# Signal handlers
func _on_workout_started():
	print(\"WorkoutSessionManager: Workout started - enabling UI\")
	_set_ui_enabled(true)

func _on_workout_completed(total_duration: int):
	print(\"WorkoutSessionManager: Workout completed - disabling UI\")
	_set_ui_enabled(false)

func _on_workout_cancelled():
	print(\"WorkoutSessionManager: Workout cancelled - disabling UI\")
	_set_ui_enabled(false)

# Core UI state management
func _set_ui_enabled(enabled: bool) -> void:
	_is_ui_enabled = enabled

	if enabled:
		modulate = _original_modulate
	else:
		modulate = Color(0.5, 0.5, 0.5, 1.0)

	if blocker:
		blocker.visible = not enabled
		blocker.mouse_filter = Control.MOUSE_FILTER_IGNORE if enabled else Control.MOUSE_FILTER_STOP
		blocker.move_to_front()


# Public methods to manually control UI state
func enable_ui():
	_set_ui_enabled(true)

func disable_ui():
	_set_ui_enabled(false)

func toggle_ui():
	_set_ui_enabled(not _is_ui_enabled)

# Called when the node enters the scene tree
func _enter_tree():
	_connect_signals()

# Clean up connections when exiting
func _exit_tree():
	if workout_session:
		if workout_session.workout_started.is_connected(_on_workout_started):
			workout_session.workout_started.disconnect(_on_workout_started)
		if workout_session.workout_completed.is_connected(_on_workout_completed):
			workout_session.workout_completed.disconnect(_on_workout_completed)
		if workout_session.workout_cancelled.is_connected(_on_workout_cancelled):
			workout_session.workout_cancelled.disconnect(_on_workout_cancelled)

# Optional: Expose as a tool for debugging
func _get_configuration_warnings():
	if not workout_session:
		return [\"WorkoutSession node not found. Please ensure the path is correct.\"]
	return []
"

