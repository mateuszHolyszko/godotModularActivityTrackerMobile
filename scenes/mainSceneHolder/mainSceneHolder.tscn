[sub_resource type="GDScript" id="GDScript_gbkoi"]
script/source = "extends ColorRect

@export var fade_out_time := 0.3
@export var fade_in_time := 0.4
@onready var CRT_shader = %Screen

var tween: Tween

signal fade_out_completed
signal fade_in_completed

func _ready():
	color = Color.BLACK
	modulate.a = 0.0
	# Set to full size
	anchor_left = 0.0
	anchor_top = 0.0
	anchor_right = 1.0
	anchor_bottom = 1.0
	offset_left = 0.0
	offset_top = 0.0
	offset_right = 0.0
	offset_bottom = 0.0
	# Always ignore input
	mouse_filter = Control.MOUSE_FILTER_IGNORE

func _stop_current_tween():
	if tween and is_instance_valid(tween):
		tween.stop()
		tween.kill()
		tween = null

func fade_out():
	_stop_current_tween()
	
	tween = create_tween()
	# Tween fade out
	tween.tween_property(self, \"modulate:a\", 1.0, fade_out_time).set_trans(Tween.TRANS_LINEAR).set_ease(Tween.EASE_IN_OUT)
	
	# Tween shader intensity if shader exists and has intensity property
	if CRT_shader and CRT_shader.material:
		# Start intensity tween at the same time
		tween.parallel().tween_property(CRT_shader.material, \"shader_parameter/intensity\", -1.5, fade_out_time).set_trans(Tween.TRANS_LINEAR).set_ease(Tween.EASE_IN_OUT)
	
	tween.finished.connect(_on_fade_out_finished)
	tween.play()

func _on_fade_out_finished():
	tween = null
	fade_out_completed.emit()

func fade_in():
	_stop_current_tween()
	
	tween = create_tween()
	# Tween fade in
	tween.tween_property(self, \"modulate:a\", 0.0, fade_in_time).set_trans(Tween.TRANS_LINEAR).set_ease(Tween.EASE_IN_OUT)
	
	# Tween shader intensity back to original value
	if CRT_shader and CRT_shader.material:
		tween.parallel().tween_property(CRT_shader.material, \"shader_parameter/intensity\", 0.2, fade_in_time).set_trans(Tween.TRANS_LINEAR).set_ease(Tween.EASE_IN_OUT)
	
	tween.finished.connect(_on_fade_in_finished)
	tween.play()

func _on_fade_in_finished():
	tween = null
	fade_in_completed.emit()
	
func play_refresh_animation():
	_stop_current_tween()
	
	# Start fully black
	modulate.a = 1.0
	
	tween = create_tween()
	tween.tween_property(self, \"modulate:a\", 0.0, fade_in_time * 2).set_trans(Tween.TRANS_LINEAR).set_ease(Tween.EASE_IN_OUT)
	
	# Add shader intensity animation for refresh effect
	if CRT_shader and CRT_shader.material:
		# Start with intense negative value
		CRT_shader.material.set_shader_parameter(\"intensity\", -2.5)
		# Tween back to normal
		tween.parallel().tween_property(CRT_shader.material, \"shader_parameter/intensity\", 0.2, fade_in_time * 2).set_trans(Tween.TRANS_LINEAR).set_ease(Tween.EASE_IN_OUT)
	
	tween.finished.connect(_on_refresh_animation_finished)
	tween.play()

func _on_refresh_animation_finished():
	tween = null
"

